<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.UTaste">

        <!-- MAIN / LOGIN / WELCOME -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ADMIN SECTION -->
        <activity
            android:name=".ui.admin.AdminActivity"
            android:exported="false" />

        <activity
            android:name=".ui.recipe.RecipeActivity"
            android:exported="false" />

        <!-- CHEF SECTION -->
        <activity
            android:name=".ui.ChefMenuActivity"
            android:exported="false" />

        <activity
            android:name=".app.chef.RecipeCaloricBalanceActivity"
            android:exported="false" />

        <activity
            android:name=".app.chef.AddIngredientToRecipeActivity"
            android:exported="false" />

    </application>

</manifest>
