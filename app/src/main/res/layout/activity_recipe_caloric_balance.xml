<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F8">

    <!-- Bouton retour -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Back"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Titre -->
    <TextView
        android:id="@+id/tvScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Recipe Caloric Balance"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#971919"
        android:gravity="center"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Label -->
    <TextView
        android:id="@+id/tvSelectLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a recipe :"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScreenTitle" />

    <!-- Spinner recette -->
    <Spinner
        android:id="@+id/spRecipe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:background="@android:drawable/editbox_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSelectLabel" />

    <!-- Bouton calcul -->
    <Button
        android:id="@+id/btnComputeBalance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Compute caloric balance"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#971919"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spRecipe" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnComputeBalance" />

    <!-- Résultats -->
    <TextView
        android:id="@+id/tvCarbs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Carbohydrates: 0.0 g"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <TextView
        android:id="@+id/tvProtein"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Proteins: 0.0 g"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCarbs" />

    <TextView
        android:id="@+id/tvFat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Fat: 0.0 g"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProtein" />

    <TextView
        android:id="@+id/tvEnergy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Total energy: 0 kcal"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFat" />

</androidx.constraintlayout.widget.ConstraintLayout>
