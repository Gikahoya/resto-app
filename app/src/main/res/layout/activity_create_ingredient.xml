<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Conteneur horizontal pour le bouton retour et le titre -->

    <!-- Conteneur horizontal pour le bouton retour et le titre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- NOUVEAU BOUTON RETOUR -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <!-- Titre, maintenant correctement centré -->
        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Create ingredient"
            android:textColor="#8C0000"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginEnd="48dp"/>


    </LinearLayout>



    <EditText
        android:id="@+id/et_ingredient_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient name" />

    <EditText
        android:id="@+id/et_qr_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Barcode"
        android:inputType="number" />


    <Button
        android:id="@+id/btn_save"
        android:layout_width="377dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/save"
        android:backgroundTint="#8C0000"
        android:textColor="@android:color/white" />

</LinearLayout>
