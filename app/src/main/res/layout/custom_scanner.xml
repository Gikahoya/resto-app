<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- La vue qui dessine le flux de la caméra -->
    <com.journeyapps.barcodescanner.BarcodeView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_framing_rect_width="280dp"
        app:zxing_framing_rect_height="280dp" />

    <!-- La vue qui dessine le laser, le masque, etc. -->
    <com.journeyapps.barcodescanner.ViewfinderView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_viewfinder_mask="@color/scanner_mask"
        app:zxing_viewfinder_laser="@color/scanner_laser"
        app:zxing_result_view="@color/scanner_success" />

</merge>