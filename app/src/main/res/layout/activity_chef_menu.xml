<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ChefMenuActivity">

    <!-- Bandeau rouge uTaste -->
    <TextView
        android:id="@+id/app_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#8C0000"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="50sp"
        app:layout_constraintHeight_percent="0.20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bouton retour en haut à gauche -->
    <ImageButton
        android:id="@+id/btn_back_chef"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:onClick="onBackClicked"
        android:padding="4dp"
        android:src="@android:drawable/ic_media_previous"
        app:layout_constraintStart_toStartOf="@id/app_id"
        app:layout_constraintTop_toTopOf="@id/app_id"
        app:layout_constraintBottom_toBottomOf="@id/app_id" />

    <!-- Welcome, Chef -->
    <TextView
        android:id="@+id/welcome_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/welcome_chef"
        android:textColor="#8C0000"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/app_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Select an option -->
    <TextView
        android:id="@+id/option_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/option"
        android:textColor="#8C0000"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/welcome_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.04" />

    <!-- Colonne de boutons -->
    <LinearLayout
        android:id="@+id/options_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/option_id"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/change_pwd"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#8C0000"
            android:onClick="onChangePasswordClicked"
            android:text="@string/change_pwd"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/edit_recipe"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#8C0000"
            android:onClick="onCreateModifyDeleteRecipeClicked"
            android:text="@string/edit_recipe"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/add_ingredient"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#8C0000"
            android:onClick="onAddIngredientToRecipeClicked"
            android:text="@string/add_ingredient"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/ingredient_quantity"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#8C0000"
            android:text="@string/ingredient_quantity"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/delete_ingredient"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#8C0000"
            android:text="@string/delete_ingredient"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/ingredients_info"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#8C0000"
            android:text="@string/ingredients_info"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/caloric_balance"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#8C0000"
            android:text="@string/caloric_balance"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/logout"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:background="#8C0000"
            android:text="@string/logout"
            android:textColor="@android:color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
