<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/edtName"
            android:hint="Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/edtDescription"
            android:hint="Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="3"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/edtImagePath"
            android:hint="Image path (optional)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:text="Create"
            android:onClick="onCreateRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>

        <Button
            android:text="Update"
            android:onClick="onUpdateRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <Button
            android:text="Delete"
            android:onClick="onDeleteRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnScanIngredientQr"
            android:layout_width="372dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:onClick="onScanIngredientQr"
            android:text="Add ingredient (QR)" />


    </LinearLayout>
</ScrollView>
